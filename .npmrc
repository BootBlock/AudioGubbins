# REQ-REPO-186: a package may import only what it declares. pnpm's isolated
# node_modules already enforces this; disabling hoisting removes the last way an
# undeclared transitive dependency could resolve by accident.
hoist=false
shamefully-hoist=false

# Peer dependencies are installed but a mismatch must not abort the install; the
# lint and typecheck gates are what decide whether a combination actually works.
auto-install-peers=true
strict-peer-dependencies=false
