{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "outDir": "./dist/types",
    "rootDir": "..",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true,
    "allowJs": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "**/*.ts",
    "../tools/build-wasm.mjs",
    "../tools/check-build-output.mjs",
    "../tools/check-record-titles.mjs",
    "../tools/read-pnpm-lockfile.mjs",
    "../tools/sync-third-party-notices.mjs"
  ],
  "exclude": ["dist"],
  "references": [
    {
      "path": "../packages/audio-engine"
    },
    {
      "path": "../packages/capabilities"
    },
    {
      "path": "../packages/commands"
    },
    {
      "path": "../packages/input"
    },
    {
      "path": "../apps/web"
    }
  ]
}
