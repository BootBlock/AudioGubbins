{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "outDir": "./dist/types",
    "rootDir": "..",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../tools/build-encoder-modules.mjs",
    "../tools/build-wasm.mjs",
    "../tools/check-build-output.mjs",
    "../tools/check-record-titles.mjs",
    "../tools/compare-latency.mjs",
    "../tools/inference-runtime-files.mjs",
    "../tools/local-traces.mjs",
    "../tools/read-pnpm-lockfile.mjs",
    "../tools/sync-third-party-notices.mjs",
    "../tools/zig-toolchain.mjs",
    "../tools/model-packs/*.mjs"
  ],
  "exclude": ["dist"],
  "references": [
    {
      "path": "../packages/audio-engine"
    },
    {
      "path": "../packages/capabilities"
    },
    {
      "path": "../packages/codec-runtime"
    },
    {
      "path": "../packages/commands"
    },
    {
      "path": "../packages/design-system"
    },
    {
      "path": "../packages/input"
    },
    {
      "path": "../packages/model-packs"
    },
    {
      "path": "../apps/web"
    }
  ]
}
