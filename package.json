{
  "name": "audiogubbins",
  "version": "0.1.0",
  "private": true,
  "description": "AudioGubbins - a local-first, non-destructive audio editor for the web.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.12.0 || ^24 || >=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm --filter @audiogubbins/web build && pnpm run build:check",
    "build:check": "node tools/check-build-output.mjs",
    "contracts:update": "vitest run --project architecture --update tests/architecture/public-contracts.test.ts",
    "dev": "pnpm --filter @audiogubbins/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph:check": "node tools/sync-workspace-graph.mjs --check",
    "graph:sync": "node tools/sync-workspace-graph.mjs",
    "lint": "pnpm run version:check && pnpm run graph:check && eslint . && prettier --check .",
    "preview": "pnpm --filter @audiogubbins/web preview",
    "record:check": "node tools/check-record-titles.mjs",
    "spec:verify": "python docs/spec/tools/verify_hardening.py",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=node_modules/.cache/audiogubbins/vitest-report.json",
    "test:architecture": "pnpm run test:dependencies && vitest run --project architecture",
    "test:audio-golden": "vitest run golden",
    "test:audio-latency": "vitest run latency",
    "test:coverage": "vitest run --coverage",
    "test:dependencies": "depcruise --config .dependency-cruiser.cjs apps packages tests tools",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium-smoke",
    "test:e2e:timeline": "playwright test --project=chromium-timeline",
    "test:renderer-loss": "playwright test --project=chromium-renderer --project=chromium-renderer-webgpu --project=chromium-renderer-reduced",
    "test:touch-pen": "playwright test --project=chromium-touch-pen",
    "test:video-reference": "playwright test --project=chromium-video-reference",
    "test:watch": "vitest",
    "test:worker-responsiveness": "vitest run responsiveness",
    "typecheck": "tsc --build tsconfig.build.json && tsc -p tsconfig.json",
    "typecheck:full": "tsc --build --force tsconfig.build.json && tsc -p tsconfig.json",
    "verify:commit": "pnpm run lint && pnpm run typecheck:full && pnpm run test && pnpm run record:check && pnpm run test:dependencies",
    "verify:integration": "pnpm run verify:commit && pnpm run build && pnpm run test:e2e",
    "version:check": "node tools/sync-version.mjs --check",
    "version:sync": "node tools/sync-version.mjs"
  },
  "devDependencies": {
    "@audiogubbins/audio-engine": "workspace:*",
    "@audiogubbins/capabilities": "workspace:*",
    "@audiogubbins/commands": "workspace:*",
    "@audiogubbins/input": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "lightningcss": "1.33.0",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
