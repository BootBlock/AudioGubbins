{
  "name": "@audiogubbins/history",
  "version": "0.1.0",
  "private": true,
  "description": "The branching project history: its graph of changes, the current node, named snapshots, whole-project comparison and the planning of compaction.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run --root ../../ --project history"
  },
  "dependencies": {
    "@audiogubbins/domain": "workspace:*",
    "@audiogubbins/commands": "workspace:*",
    "@audiogubbins/project-format": "workspace:*"
  },
  "devDependencies": {
    "@audiogubbins/test-fixtures": "workspace:*",
    "vitest": "5.0.3"
  }
}
