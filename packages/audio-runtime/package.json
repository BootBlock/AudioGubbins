{
  "name": "@audiogubbins/audio-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "The browser host of the audio engine: the audio context, the AudioWorklet processor, the render worker and their typed messages.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./threads/*": "./src/threads/*",
    "./capture-channel": {
      "types": "./src/capture/capture-reader.ts",
      "default": "./src/capture/capture-reader.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/threads/*"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run --root ../../ --project audio-runtime"
  },
  "dependencies": {
    "@audiogubbins/domain": "workspace:*",
    "@audiogubbins/diagnostics": "workspace:*",
    "@audiogubbins/capabilities": "workspace:*",
    "@audiogubbins/audio-graph": "workspace:*",
    "@audiogubbins/audio-engine": "workspace:*",
    "@audiogubbins/effect-rack": "workspace:*",
    "@audiogubbins/processors": "workspace:*",
    "@audiogubbins/ml-runtime": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
