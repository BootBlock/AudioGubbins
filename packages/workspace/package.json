{
  "name": "@audiogubbins/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Dockable workspace contracts, layout persistence and presets, with Dockview contained behind an adapter.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/*.css": "./src/styles/*.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run --root ../../ --project workspace"
  },
  "dependencies": {
    "@audiogubbins/diagnostics": "workspace:*",
    "@audiogubbins/text": "workspace:*",
    "@audiogubbins/version": "workspace:*",
    "dockview": "8.3.1",
    "dockview-react": "8.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@audiogubbins/test-fixtures": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "vitest": "5.0.3"
  }
}
