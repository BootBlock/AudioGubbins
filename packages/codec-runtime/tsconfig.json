{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "outDir": "./dist/types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist"
  ],
  "references": [
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/codecs"
    },
    {
      "path": "../../packages/import-export"
    },
    {
      "path": "../../packages/capabilities"
    },
    {
      "path": "../../packages/version"
    },
    {
      "path": "../../packages/diagnostics"
    }
  ]
}
