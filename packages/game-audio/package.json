{
  "name": "@audiogubbins/game-audio",
  "version": "0.1.0",
  "private": true,
  "description": "Game audio as values: asset groups, inherited policy and its provenance, naming templates, game export profiles and the game preview.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run --root ../../ --project game-audio"
  },
  "dependencies": {
    "@audiogubbins/domain": "workspace:*",
    "@audiogubbins/import-export": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
