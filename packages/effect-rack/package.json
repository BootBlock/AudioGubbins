{
  "name": "@audiogubbins/effect-rack",
  "version": "0.1.0",
  "private": true,
  "description": "The effect rack: a chain of processors realised as the processing graph, with parallel groups, bypass, solo and wet/dry, run over a stream.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run --root ../../ --project effect-rack"
  },
  "dependencies": {
    "@audiogubbins/domain": "workspace:*",
    "@audiogubbins/audio-graph": "workspace:*",
    "@audiogubbins/audio-engine": "workspace:*",
    "@audiogubbins/processors": "workspace:*"
  },
  "devDependencies": {
    "@audiogubbins/test-fixtures": "workspace:*",
    "vitest": "5.0.1"
  }
}
