  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run --root ../../ --project clipboard"
  },
  "dependencies": {
    "@audiogubbins/domain": "workspace:*",
    "@audiogubbins/project-format": "workspace:*",
    "@audiogubbins/text": "workspace:*"
  },
  "devDependencies": {
    "@audiogubbins/test-fixtures": "workspace:*",
    "vitest": "5.0.1"
  }
}
