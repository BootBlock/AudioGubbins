{
  "name": "@audiogubbins/storage-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "The browser host of project storage: the storage worker, the typed messages between it and the page, and the page's client.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./threads/*": "./src/threads/*",
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/threads/*"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run --root ../../ --project storage-runtime"
  },
  "dependencies": {
    "@audiogubbins/domain": "workspace:*",
    "@audiogubbins/diagnostics": "workspace:*",
    "@audiogubbins/capabilities": "workspace:*",
    "@audiogubbins/commands": "workspace:*",
    "@audiogubbins/history": "workspace:*",
    "@audiogubbins/project-format": "workspace:*",
    "@audiogubbins/project-commands": "workspace:*",
    "@audiogubbins/media-store": "workspace:*",
    "@audiogubbins/storage": "workspace:*",
    "@audiogubbins/browser-storage": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
