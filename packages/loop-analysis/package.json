{
  "name": "@audiogubbins/loop-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "Seamless-loop analysis: seam metrics, the candidate search, the micro-crossfade suggestion and the loop audition plans.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run --root ../../ --project loop-analysis"
  },
  "dependencies": {
    "@audiogubbins/domain": "workspace:*",
    "@audiogubbins/audio-engine": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
