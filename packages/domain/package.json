{
  "name": "@audiogubbins/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic AudioGubbins project and domain model. Owns domain truth; depends on nothing.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run --root ../../ --project domain"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
