{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "outDir": "./build/types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./build/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "build"
  ],
  "references": [
    {
      "path": "../../packages/commands"
    },
    {
      "path": "../../packages/capabilities"
    },
    {
      "path": "../../packages/design-system"
    },
    {
      "path": "../../packages/workspace"
    },
    {
      "path": "../../packages/diagnostics"
    },
    {
      "path": "../../packages/input"
    },
    {
      "path": "../../packages/text"
    },
    {
      "path": "../../packages/version"
    },
    {
      "path": "../../packages/project-format"
    },
    {
      "path": "../../packages/project-commands"
    },
    {
      "path": "../../packages/history"
    },
    {
      "path": "../../packages/media-store"
    },
    {
      "path": "../../packages/storage"
    },
    {
      "path": "../../packages/browser-storage"
    },
    {
      "path": "../../packages/test-fixtures"
    }
  ]
}
